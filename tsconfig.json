{
  "compilerOptions": {
    /* Basic setup */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,

    /* Node + ESM interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    /* Types and tooling */
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./src/types"],

    /* Build behavior */
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "ts-node": {
    "esm": true
  }
}
